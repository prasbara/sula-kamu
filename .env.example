# ==========================================
# SULA — Product & Security Configuration
# ==========================================

# Telegram Bot Token (Obtained from @BotFather)
# NEVER commit or share this token!
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Bot Operation Mode: 'polling' (dev) or 'webhook' (prod)
BOT_MODE=polling

# Webhook Configuration (if BOT_MODE=webhook)
WEBHOOK_URL=https://your-domain.com/telegram/webhook
WEBHOOK_SECRET=your_super_secret_webhook_key

# Admin Dashboard Server
ADMIN_PORT=3000
ADMIN_HOST=127.0.0.1
ADMIN_API_KEY=sula_super_admin_secret_key_change_in_production

# Encryption & Data Protection (32-byte hex for AES-256)
APP_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Path
DATABASE_PATH=./data/sula.db

# Security & Verification
MAX_VERIFICATION_ATTEMPTS=3
VERIFICATION_COOLDOWN_HOURS=48
KTM_RETENTION_HOURS=72

# Coarse Location Default
REGION_SCOPE=Semarang
